theme: ''
styleConstants:
  - '------ TASKBAR ------'
  - BackgroundColor_tb = "#0b0c0a"
  - '------ ITEM REPEATER ------ # for filling in taskbar space: right margin -58 w/o widget, -12 w/ widget'
  - Margin_ir = 0,0,-12,0
  - '------ START BUTTON ------'
  - Visibility_sb = Visible
  - Padding_sb = 8,4,2,4
  - Width_sb = 26
  - '------ TASKVIEW ------'
  - Width_tv = 90
  - '------ TASKLIST BUTTON ------'
  - Width_tlb = 5000
  - Padding_tlb = 0,0,0,0
  - Margin_tlb = 0,0,0,0
  - '-- BUTTON GRID # an arbitrarily high width is used to fill the item repeater'
  - Width_tlbg = 5000
  - Padding_tlbg = 0,0,0,0
  - '-- BUTTON BORDER'
  - BorderThickness_tlb = 2,2,2,2
  - '-- BUTTON ICON'
  - Visibility_tlbi = Collapsed
  - '-- BUTTON LABEL'
  - Margin_tlbl = -20,0,0,0
  - MaxWidth_tlbl = $Width_tlbg
  - FontFamily_tlbl = Cascadia Mono
  - FontSize_tlbl = 12
  - HorizontalAlignment_tlbl = Left
  - '-- BUTTON RUNNING INDICATOR'
  - Visibility_tlbri = Collapsed
  - '------ WIDGET ------'
  - empty
  - '------ HIDDEN ICON MENU ------'
  - '-- MENU VIEW'
  - Width_himv = 32
  - Height_himv = 32
  - '-- MENU TEXT'
  - Text_himt = 
  - FontFamily_himt = Segoe Fluent Icons
  - FontSize_him = 16
  - '====================================================================='
  - buttonInactiveNormal=#222222
  - barLabelPointerOver=#8A8A8A
  - buttonPointerOver=#373737
  - buttonBorderPointerOver=#434343
  - buttonActive=<SolidColorBrush Color="#295576"/>
  - indicatorActive=<SolidColorBrush Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.7" />
  - indicatorInactive=<SolidColorBrush Color="Gray" Opacity="0.7" />
  - indicatorPointerOver=<SolidColorBrush Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.8" />
  - buttonAttention=<SolidColorBrush Color="#ce640c" Opacity="0.5" />
  - indicatorAttention=<SolidColorBrush Color="#ce640c" Opacity="0.9" />
  - selectionBorder=<LinearGradientBrush StartPoint='0,0' EndPoint='1,0'><GradientStop Color='Transparent' Offset='0.0' /><GradientStop Color='Transparent' Offset='0.2' /><GradientStop Color='{ThemeResource SystemAccentColorLight2}' Offset='0.2' /><GradientStop Color='{ThemeResource SystemAccentColorLight2}' Offset='0.8' /><GradientStop Color='Transparent' Offset='0.8' /><GradientStop Color='Transparent' Offset='1.0' /></LinearGradientBrush>
  - selectionBorderExtended=<SolidColorBrush Color="{ThemeResource SystemAccentColorLight2}" />
  - WindhawkBlur=#222222
  - Acrylic=<AcrylicBrush TintColor="#2a2e32" TintOpacity="0.8" FallbackColor="#2a2e32" />
controlStyles:
  - target: Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundFill
    styles:
      - Fill:=<SolidColorBrush Color=$BackgroundColor_tb  Opacity="1.0" />
  - target: Taskbar.TaskbarFrame > Grid#RootGrid > Microsoft.UI.Xaml.Controls.ItemsRepeater#TaskbarFrameRepeater
    styles:
      - Margin=$Margin_ir
  - target: Taskbar.ExperienceToggleButton#LaunchListButton[AutomationProperties.AutomationId=StartButton] > Taskbar.TaskListButtonPanel#ExperienceToggleButtonRootPanel
    styles:
      - Visibility=$Visibility_sb
      - Padding=$Padding_sb
      - Width=$Width_sb
  - target: Taskbar.ExperienceToggleButton#LaunchListButton[AutomationProperties.AutomationId=TaskViewButton] > Taskbar.TaskListButtonPanel#ExperienceToggleButtonRootPanel
    styles:
      - Width=$Width_tv
  - target: Taskbar.TaskListButton
    styles:
      - Margin=$Margin_tlb
      - Padding=$Padding_tlb
  - target: Grid#IconPanel
    styles:
      - Padding=$Padding_tlbg
      - Width=$Width_tlbg
  - target: Taskbar.TaskListButton > Grid@CommonStates > Border#BackgroundElement
    styles:
      - CornerRadius=0
      - BorderBrush=#363636
      - Background@ActiveNormal:=$buttonActive
      - BorderBrush@ActiveNormal=#476E8B
      - Background@InactiveNormal:=$buttonInactiveNormal
      - Background@ActivePointerOver:=$buttonPointerOver
      - BorderBrush@ActivePointerOver=$buttonBorderPointerOver
      - Background@MultiWindowNormal:=$buttonInactiveNormal
      - Background@MultiWindowPointerOver:=$buttonPointerOver
      - Background@InactivePointerOver:=$buttonPointerOver
      - BorderBrush@InactivePointerOver=$buttonBorderPointerOver
      - Background@ActivePressed:=$buttonPointerOver
      - Background@InactivePressed:=$buttonPointerOver
      - Background@MultiWindowPressed:=$buttonPointerOver
      - Background@MultiWindowActive:=$buttonActive
      - Background@RequestingAttention:=$buttonAttention
      - Background@RequestingAttentionPointerOver:=$buttonPointerOver
      - Background@RequestingAttentionPressed:=$buttonPointerOver
      - Background@RequestingAttentionMulti:=$buttonAttention
      - Background@RequestingAttentionMultiPointerOver:=$buttonPointerOver
      - Background@RequestingAttentionMultiPressed:=$buttonPointerOver
  - target: Taskbar.TaskListButton > Grid@CommonStates > Border
    styles:
      - BorderThickness = $BorderThickness_tlb
  - target: Grid#IconPanel > Image#Icon
    styles:
      - Visibility=$Visibility_tlbi
  - target: Grid#IconPanel@CommonStates > TextBlock#LabelControl
    styles:
      - HorizontalAlignment=$HorizontalAlignment_tlbl
      - Margin=$Margin_tlbl
      - MaxWidth=$MaxWidth_tlbl
      - FontFamily=$FontFamily_tlbl
      - FontSize=$FontSize_tlbl
      - Foreground=#777
      - Foreground@ActiveNormal=#FFF
      - Foreground@ActivePointerOver=$barLabelPointerOver
      - Foreground@MultiWindowPointerOver=$barLabelPointerOver
      - Foreground@InactivePointerOver=$barLabelPointerOver
      - Foreground@ActivePressed=$barLabelPointerOver
      - Foreground@InactivePressed=$barLabelPointerOver
      - Foreground@MultiWindowPressed=$barLabelPointerOver
  - target: Grid#IconPanel > Rectangle#RunningIndicator
    styles:
      - Visibility=$Visibility_tlbri



  - target: SystemTray.Stack#NotifyIconStack > Grid#Content > StackListView
    styles:
      - Height = 20
  - target: SystemTray.Stack#NotifyIconStack > Grid#Content > StackListView#IconStack > ItemPresenter > StackPanel > ContentPresenter, SystemTray.Stack#NotifyIconStack > Grid#Content > StackListView#IconStack > ItemPresenter > StackPanel > ContentPresenter > ChevronIconView
    styles:
      - VerticalAlignment = Center
      - VerticalContentAlignment = Center
      - Height=10



  - target: SystemTray.ChevronIconView
    styles:
      - Width=$Width_himv
      - Height=$Height_himv
  - target: SystemTray.ChevronIconView > Windows.UI.Xaml.Controls.Grid > Windows.UI.Xaml.Controls.ContentPresenter > Windows.UI.Xaml.Controls.Grid > SystemTray.TextIconContent > Windows.UI.Xaml.Controls.Grid > SystemTray.AdaptiveTextBlock#Base > TextBlock
    styles:
      - Text=$Text_himt
      - FontFamily=$FontFamily_himt
      - FontSize=$FontSize_himt
  - target: SystemTray.OmniButton#ControlCenterButton > Grid > ContentPresenter > ItemsPresenter > StackPanel > ContentPresenter > SystemTray.IconView#SystemTrayIcon > Grid#ContainerGrid
    styles:
      - Padding=4,0,4,0
  - target: SystemTray.OmniButton#NotificationCenterButton > Grid > ContentPresenter > ItemsPresenter > StackPanel > ContentPresenter > SystemTray.IconView#SystemTrayIcon > Grid#ContainerGrid
    styles:
      - Padding=4,0,4,0
  - target: SystemTray.AdaptiveTextBlock#LanguageInnerTextBlock > Windows.UI.Xaml.Controls.TextBlock#InnerTextBlock
    styles:
      - TextTrimming=1
      - Height=20
      - FontSize=14
  - target: TextBlock#BatteryTextBlock
    styles:
      - FontSize=14
  - target: TextBlock#TimeInnerTextBlock
    styles:
      - FontSize=14
  - target: TextBlock#DateInnerTextBlock
    styles:
      - Visibility=Collapsed
  - target: StackPanel#SystemTrayFrameGrid, Grid#SystemTrayFrameGrid
    styles:
      - Margin=0,-4,0,-4
      - Opacity=0.75
  - target: SystemTray.IconView#SystemTrayIcon > Grid#ContainerGrid@ > Rectangle#ShowDesktopPipe
    styles:
      - Fill=Transparent
themeResourceVariables:
  - 
clickThroughTaskbar: 0
xamlDiagnosticsHandling: ''